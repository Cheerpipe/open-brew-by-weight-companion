# Rendered by gateway.py, which fills the placeholders at runtime.
user nginx;  # Owns the image's temp folders, which hold OTA upload chunks.
worker_processes 1;
pid @RUN@/nginx.pid;
error_log stderr warn;

events {
  worker_connections 256;
}

http {
  include /etc/nginx/mime.types;
  access_log off;
  server_tokens off;
  absolute_redirect off;  # Redirects keep the host and port the browser used.

  # Compress the dynamic JSON the screens pull (history, curves, stats).
  # Assets reach the controller's answer already gzip and firmware update
  # chunks are octet-stream, so neither is recompressed; small answers and
  # the WebSocket stay plain.
  gzip on;
  gzip_proxied any;
  gzip_types application/json;
  gzip_min_length 512;
  gzip_comp_level 5;
  gzip_vary on;

  # Close upstream connections after each request: the controller has few sockets.
  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  # Web UI shell and assets, so each device's first load and the loads after an
  # OTA reach the controller once instead of once per device. Keyed by the full
  # URI: the controller only marks ?v=<asset tag> URLs cacheable.
  proxy_cache_path @RUN@/cache levels=1:2 keys_zone=webui:1m max_size=16m inactive=30d use_temp_path=off;

  # Setup page and certificate downloads, reachable before the CA is trusted.
  server {
    listen @HTTP_PORT@ default_server;
    root @RUN@/www;
    index index.en.html;
    add_header Cache-Control "no-store" always;
    log_not_found off;  # Browsers probe for icons this page does not have.

    # Gateway state for ./setup, Docker health checks and monitoring tools.
    location = /__companion/gateway {
      default_type application/json;
      alias @RUN@/status.json;
    }

    # The HTTPS gateway's earlier address for it.
    location = /__gateway/status {
      return 301 /__companion/gateway;
    }

    # Open Brew by Weight Companion's own pages and status.
    location ^~ /__companion/ {
      proxy_pass http://unix:@RUN@/companion.sock;
      proxy_http_version 1.1;
    }

    location = /__companion {
      return 301 /__companion/;
    }

    location ~ \.mobileconfig$ {
      types { }
      default_type application/x-apple-aspen-config;
    }
  }

  server {
    listen @HTTPS_PORT@ ssl default_server;
    http2 on;
    ssl_certificate @DATA@/server.crt;
    ssl_certificate_key @DATA@/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:tls:1m;

    # The setup page probes this to learn whether the device trusts the CA.
    location = /__companion/ping {
      add_header Cache-Control "no-store" always;
      return 204;
    }

    location = /__companion/gateway {
      add_header Cache-Control "no-store" always;
      default_type application/json;
      alias @RUN@/status.json;
    }

    location = /__gateway/status {
      return 301 /__companion/gateway;
    }

    # Open Brew by Weight Companion's own pages and status.
    location ^~ /__companion/ {
      proxy_pass http://unix:@RUN@/companion.sock;
      proxy_http_version 1.1;
    }

    location = /__companion {
      return 301 /__companion/;
    }

    # Asked before each Web UI page: the companion answers 403 while the
    # controller wants the Web UI opened directly, and the page names its address.
    location = /__companion/ui-gate {
      internal;
      proxy_pass http://unix:@RUN@/companion.sock;
      proxy_http_version 1.1;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
      proxy_set_header X-Original-URI $request_uri;
    }

    # The Web UI's live updates and API go through the companion, which shares
    # one controller session between every screen and signs each call as
    # relayed. X-Real-IP names the browser; nginx always sets it.
    location = /api/v1/ui/ui-stream {
      @OFFLINE@
      proxy_pass http://unix:@RUN@/companion.sock;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_buffering off;
      proxy_read_timeout 1h;
    }

    # The companion's own controller routes are never reachable through it...
    location ^~ /api/v1/companion/ {
      return 404;
    }

    # ...except Admin → Companion's actions, which a browser sends.
    location = /api/v1/companion/admin {
      @OFFLINE@
      proxy_pass http://unix:@RUN@/companion.sock;
      proxy_http_version 1.1;
      proxy_set_header X-Real-IP $remote_addr;
    }

    # The rest of the API; firmware updates send 64 KiB chunks.
    location ^~ /api/ {
      @OFFLINE@
      proxy_pass http://unix:@RUN@/companion.sock;
      proxy_http_version 1.1;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_request_buffering off;
      proxy_buffering off;
      client_max_body_size 1m;
      proxy_read_timeout 5m;
    }

    # Versioned assets: cached for as long as the controller allows, which is
    # a year for ?v=<asset tag> and never for any other URL. The controller
    # always sends gzip, so one copy serves every Accept-Encoding.
    location ~ ^/(app\.(js|css)|js/[a-z-]+\.js|manifest\.webmanifest|icons/icon-192\.png|favicon\.ico|apple-touch-icon[^/]*)$ {
      @OFFLINE@
      proxy_pass http://@UPSTREAM@;
      proxy_set_header Host @UPSTREAM@;
      proxy_set_header Origin http://@UPSTREAM@;
      proxy_http_version 1.1;
      proxy_connect_timeout 5s;
      proxy_cache webui;
      proxy_cache_lock on;
      proxy_ignore_headers Vary;
      add_header X-Gateway-Cache $upstream_cache_status always;
    }

    # Shell pages and the service worker: checked with the controller on each
    # load, at most every second or two (a 304 when unchanged, so an OTA shows
    # at once), and served from the last copy while the controller is off.
    location ~ ^/(diagnostic|log|stats|history|admin|settings|setup|sw\.js)?$ {
      @OFFLINE@
      auth_request /__companion/ui-gate;
      error_page 403 = /__companion/ui-off;
      proxy_pass http://@UPSTREAM@;
      proxy_set_header Host @UPSTREAM@;
      proxy_set_header Origin http://@UPSTREAM@;
      proxy_http_version 1.1;
      proxy_connect_timeout 5s;
      proxy_cache webui;
      proxy_cache_lock on;
      proxy_ignore_headers Cache-Control Expires Vary;
      proxy_cache_valid 200 1s;
      proxy_cache_revalidate on;
      proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
      add_header X-Gateway-Cache $upstream_cache_status always;
    }

    # Anything else the Web UI loads. The controller only answers requests addressed to itself.
    location / {
      @OFFLINE@
      proxy_pass http://@UPSTREAM@;
      proxy_set_header Host @UPSTREAM@;
      proxy_set_header Origin http://@UPSTREAM@;
      proxy_http_version 1.1;
      proxy_set_header Connection close;
      proxy_buffering off;
      proxy_connect_timeout 5s;
    }
  }
}
