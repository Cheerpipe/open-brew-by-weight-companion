    "R0": (".gitignore", "LICENSE"),
}


IMAGE = "openbrewbyweight-companion"
TEST_IMAGE = f"{IMAGE}:test"
# Not :local, which is the tag ./setup runs: a gate never replaces it.
RUNTIME_IMAGE = f"{IMAGE}:validate"
DOCKERFILE_LABEL = "org.openbrewbyweight.companion.dockerfile"
COVERAGE_FAIL_UNDER = 85  # The whole suite's branch coverage; raise it as tests grow.
PAGES = (
