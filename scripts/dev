#!/usr/bin/env python3
"""Canonical, non-bootstrapping developer command facade for the companion.

It classifies changed paths into risk levels and runs the matching gate. It
never installs anything: the Python tools come from `uv sync --frozen`, the web
linters from `npm ci` and the images from `./scripts/dev image`, each run
explicitly. Every run writes its full log and a JSON summary under
artifacts/runs/<run-id>/.
"""

from __future__ import annotations

import datetime as dt
import hashlib
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import tokenize
import tomllib
from dataclasses import dataclass, field
from pathlib import Path
from urllib.parse import unquote, urlsplit

ROOT = Path(__file__).resolve().parent.parent
COLOR_ENABLED = (
    os.getenv("NO_COLOR") is None and os.getenv("TERM") != "dumb" and sys.stdout.isatty()
)

RANK = {f"R{i}": i for i in range(4)}
# Focused paths per area, for `context` and kept honest by the docs check.
AREAS: dict[str, tuple[str, list[str]]] = {
    "gateway": (
        "supervisor, discovery, certificates, nginx and the setup page",
        [
            "gateway/gateway.py",
            "gateway/nginx.conf.in",
            "tests/test_gateway.py",
            "tests/test_scan.py",
        ],
    ),
    "link": (
        "pairing, the controller link and its shared vectors",
        ["companion/pairing.py", "companion/crypto.py", "companion/link.py", "tests/test_link.py"],
    ),
    "relay": (
        "the Web UI relay and every screen",
        ["companion/relay.py", "companion/mux.py", "companion/screens.py", "tests/test_screens.py"],
    ),
    "storage": (
        "the log history, the shot archive and their migrations",
        ["companion/logstore.py", "companion/archive.py", "tests/test_logstore.py"],
    ),
    "lamarzocco": (
        "the La Marzocco cloud client",
        ["companion/lamarzocco.py", "companion/dashboard.py", "tests/test_lamarzocco.py"],
    ),
    "runtime": (
        "the image, compose files and ./setup",
        ["Dockerfile", "compose.yaml", "setup", "tests/test_setup.py"],
    ),
    "tooling": (
        "the validation gates and their configuration",
        ["scripts/dev", "pyproject.toml", "package.json", "VALIDATION.md", "docs/SCRIPTS.md"],
    ),
}
SECRET = re.compile(r"(?i)(password|token)(\s*[=:]\s*|\s+)\S+")

# Risk surface (VALIDATION.md). R3: trust (TLS, pairing, keys) and the controller link;
# R2: what the companion stores, relays or runs as; R1: pages, pure logic, tests and
# tooling; R0: prose. Paths are exact unless they end in "/"; anything else is R3.
RISK_PATHS = {
    "R3": (
        "gateway/gateway.py",
        "gateway/nginx.conf.in",
        "companion/__init__.py",
        "companion/crypto.py",
        "companion/link.py",
