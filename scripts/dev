SHELL_SCRIPTS = ("setup", "gateway/entrypoint.sh")
# The Dockerfile installs these exports of uv.lock: the runtime, and pytest and coverage.
REQUIREMENTS = {
    "requirements/runtime.txt": ("--no-dev",),
    "requirements/test.txt": ("--only-group", "test"),
