#!/usr/bin/env bash
# Sets up Open Brew by Weight Companion on this Linux server: chooses how it
# joins the network, writes .env, starts the container and checks that it
# works end to end. It decides on its own where it can and asks otherwise.
#
# Usage: ./setup [--yes]
#   --yes  accept every suggestion without asking (also used without a terminal)
set -Eeuo pipefail
cd "$(dirname "$0")"
trap 'die "./setup stopped unexpectedly at line $LINENO. Please report this line."' ERR

YES=0
[[ ${1:-} == --yes || ${1:-} == -y ]] && YES=1
{ : <>/dev/tty; } 2>/dev/null || YES=1

bold() { printf '\n\033[1m%s\033[0m\n' "$*"; }
say() { printf '  %s\n' "$*"; }
warn() { printf '  \033[33m%s\033[0m\n' "$*"; }
die() {
	printf '\n\033[31m%s\033[0m\n' "$*" >&2
	exit 1
}
ask() { # ask QUESTION DEFAULT: prints the answer, or DEFAULT with --yes
	local answer
	if ((YES)); then
		printf '%s\n' "$2"
		return
	fi
	read -r -p "  $1 [$2]: " answer </dev/tty
	printf '%s\n' "${answer:-$2}"
}
confirm() { # confirm QUESTION: yes unless the user says no
	local answer
	((YES)) && return 0
	read -r -p "  $1 [Y/n]: " answer </dev/tty
	[[ ! $answer =~ ^[Nn] ]]
}
env_get() { [[ ! -f ${2:-.env} ]] || sed -n "s/^$1=//p" "${2:-.env}" | tail -n 1; }
env_set() { # env_set KEY VALUE: set, uncomment or append the line in .env
	local tmp
	tmp=$(mktemp)
	awk -v k="$1" -v v="$2" '$0 ~ "^# ?" k "=|^" k "=" && !done { print k "=" v; done = 1; next }
		{ print } END { if (!done) print k "=" v }' .env >"$tmp"
	mv "$tmp" .env
}
ip2int() {
	local a b c d
	IFS=. read -r a b c d <<<"$1"
	echo $(((a << 24) | (b << 16) | (c << 8) | d))
}
int2ip() { echo "$(($1 >> 24 & 255)).$(($1 >> 16 & 255)).$(($1 >> 8 & 255)).$(($1 & 255))"; }
in_subnet() { (($(ip2int "$1") >> (32 - ${SUBNET#*/}) == $(ip2int "${SUBNET%/*}") >> (32 - ${SUBNET#*/}))); }
in_use() { # answers ping or ARP, or already belongs to a container on the network
	[[ " $TAKEN " == *" $1 "* ]] && return 0
	ping -c 1 -W 1 "$1" >/dev/null 2>&1 && return 0
	ip neigh show "$1" 2>/dev/null | grep -q lladdr
}
check() { docker compose exec -T companion python3 /opt/gateway/gateway.py check "$@" 2>&1; }
running() { [[ -n $(docker compose ps -q --status running companion 2>/dev/null) ]]; }
migrate_env() { # gives settings from the HTTPS gateway era their companion names
	local tmp
	[[ -f .env ]] || return 0
	tmp=$(mktemp)
	sed -E -e 's/^(# ?)?GATEWAY_(HOSTNAME|IP|DATA)=/\1COMPANION_\2=/' \
		-e 's/^(# ?)?(HTTPS?_PORT|MDNS_PUBLISH)=/\1COMPANION_\2=/' .env >"$tmp"
	if cmp -s .env "$tmp"; then
		rm -f "$tmp"
		return 0
	fi
	cp .env .env.bak
	mv "$tmp" .env
	say "Renamed the settings in .env to the companion's names (the earlier file is .env.bak)."
}

migrate_env

bold "Checking this server"
command -v docker >/dev/null || die "Docker is not installed. Install Docker Engine first: https://docs.docker.com/engine/install/"
docker info >/dev/null 2>&1 || die "This user cannot use Docker. Run: sudo ./setup"
version=$(docker compose version --short 2>/dev/null) || die "Docker Compose v2 (the 'docker compose' command) is missing."
printf '%s\n%s\n' 2.24 "${version#v}" | sort -V -C || die "Docker Compose $version is too old; 2.24 or newer is needed."
command -v ip >/dev/null || die "The 'ip' command (package iproute2) is missing."
say "Docker $(docker version -f '{{.Server.Version}}'), Compose ${version#v}"

KEEP=0 TAKEN=""
if [[ -f .env ]] && confirm "Settings from an earlier run exist. Keep them and just start and check the companion?"; then
	KEEP=1
fi

if ((! KEEP)); then
	bold "Looking at your network"
	read -r ROUTER DEV < <(ip -4 route show default | awk '{ for (i = 1; i < NF; i++) { if ($i == "via") r = $(i + 1); if ($i == "dev") d = $(i + 1) } print r, d; exit }')
	[[ -n ${DEV:-} ]] || die "This server has no default route. Is it connected to your network?"
	read -r SUBNET HOST_IP < <(ip -4 route show dev "$DEV" scope link proto kernel | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $1, $(i + 1); exit } }')
	[[ -n ${SUBNET:-} ]] || die "Could not read the address range of $DEV."
	DRIVER=macvlan LINK=wired
	[[ -d /sys/class/net/$DEV/wireless ]] && DRIVER=ipvlan LINK=Wi-Fi
	say "Interface $DEV ($LINK), network $SUBNET, router $ROUTER, this server $HOST_IP"

	if [[ -f .env ]]; then
		cp .env .env.bak
		say "Saved the earlier settings to .env.bak."
	fi
	docker compose down >/dev/null 2>&1 || true
	cp .env.example .env
	for key in COMPANION_NAME COMPANION_HOSTNAME OBBW_CONTROLLER_URL OBBW_CONTROLLER_NAME COMPANION_MDNS_PUBLISH COMPANION_DATA; do
		value=$(env_get "$key" .env.bak)
		[[ -n $value ]] && env_set "$key" "$value"
	done
	env_set LAN_INTERFACE "$DEV"
	env_set LAN_SUBNET "$SUBNET"
	env_set LAN_ROUTER "$ROUTER"
	env_set LAN_DRIVER "$DRIVER"

	if command -v ss >/dev/null && ! ss -Hltn '( sport = :80 or sport = :443 )' | grep -q . &&
		confirm "Ports 80 and 443 are free here, so the companion can simply share this server's address ($HOST_IP). Do that?"; then
		env_set COMPOSE_FILE compose.yaml:compose.host.yaml
		env_set COMPANION_IP "$HOST_IP"
		say "The companion will share this server's address."
	else
		say "Ports 80 or 443 are in use here, so the companion gets an address of its own on your network."
		own="$(basename "$PWD" | tr '[:upper:]' '[:lower:]')_lan"
		EXISTING=""
		while read -r name parent subnet; do
			[[ $name != "$own" && $parent == "$DEV" && $subnet == "$SUBNET" ]] && EXISTING=$name && break
		done < <(docker network ls -q --filter driver=macvlan --filter driver=ipvlan |
			xargs -r docker network inspect -f '{{.Name}} {{index .Options "parent"}} {{range .IPAM.Config}}{{.Subnet}} {{end}}')
		TAKEN="$HOST_IP $ROUTER"
		if [[ -n $EXISTING ]]; then
			say "Docker network '$EXISTING' already covers $SUBNET (Docker allows only one); the companion will join it."
			env_set COMPOSE_FILE compose.yaml:compose.existing-network.yaml
			env_set LAN_NETWORK "$EXISTING"
			TAKEN+=" $(docker network inspect -f '{{range .Containers}}{{.IPv4Address}} {{end}}' "$EXISTING" | sed 's#/[0-9]*##g')"
		fi

		last=$(($(ip2int "${SUBNET%/*}") + (1 << (32 - ${SUBNET#*/})) - 2))
		previous=$(env_get COMPANION_IP .env.bak)
		suggestion=""
		if [[ -n $previous ]] && in_subnet "$previous" && ! in_use "$previous"; then
			suggestion=$previous
		else
			for ((n = last - 14; n > last - 54 && n > last - (1 << (32 - ${SUBNET#*/})) + 2; n--)); do
				in_use "$(int2ip "$n")" || {
					suggestion=$(int2ip "$n")
					break
				}
			done
		fi
		[[ -n $suggestion ]] || die "Could not find a free address in $SUBNET. Set COMPANION_IP in .env by hand."
		say "The companion needs an address no other device uses, outside the range your router"
		say "hands out automatically (DHCP; your router's settings show it). $suggestion looks free."
		while :; do
			COMPANION_IP=$(ask "Companion address" "$suggestion")
			if [[ ! $COMPANION_IP =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || ! in_subnet "$COMPANION_IP"; then
				warn "$COMPANION_IP is not an address in $SUBNET."
			elif [[ $COMPANION_IP != "$suggestion" ]] && in_use "$COMPANION_IP"; then
				warn "$COMPANION_IP is already in use by another device."
			else
				break
			fi
			((YES)) && die "No usable companion address; set COMPANION_IP in .env by hand."
		done
		env_set COMPANION_IP "$COMPANION_IP"
	fi
fi
[[ -n $(env_get COMPANION_NAME) ]] || env_set COMPANION_NAME "$(hostname -s 2>/dev/null || echo Companion)"

start() {
	local out
	docker rm -f openbrewbyweight-https-gateway >/dev/null 2>&1 || true # the container before the rename
	if ! out=$(docker compose up -d --build --remove-orphans 2>&1); then
		printf '%s\n' "$out" | tail -n 5
		[[ $out == *"Pool overlaps"* ]] && warn "Another Docker network covers your LAN; run ./setup again and choose new settings."
		[[ $out == *"address already in use"* ]] && warn "A port the companion needs is busy; run ./setup again and choose new settings."
		die "Docker could not start the companion; the lines above say why."
	fi
}
wait_for_controller() { # up to about 80 s: discovery asks the network again after 30 s
	for _ in $(seq 1 26); do
		RESULT=$(check) && return 0
		running || {
			docker compose logs --tail 30 companion
			die "The companion stopped; its log is above."
		}
		sleep 3
	done
	return 1
}

bold "Starting the companion"
say "Building the image takes about a minute the first time."
start
until wait_for_controller; do
	others=$(printf '%s\n' "$RESULT" | sed -n 's/^seen controller \(.*\): .*/\1/p')
	if [[ $RESULT == *"fail gateway"* ]]; then
		printf '%s\n' "$RESULT"
		die "The companion is running but its own pages do not answer. Run: docker compose logs"
	elif [[ -n $others ]]; then
		say "Found these controllers, but none matches OBBW_CONTROLLER_NAME:"
		printf '    %s\n' "$others"
		env_set OBBW_CONTROLLER_NAME "$(ask "Which one should the companion use" "$(head -n 1 <<<"$others")")"
	else
		say "The companion has not found the controller over mDNS. That happens when it is off, or when"
		say "your network does not pass mDNS between them. Its address is in the Web UI under Admin → Network."
		((YES)) && die "Set OBBW_CONTROLLER_URL=http://<controller address> in .env and run ./setup again."
		address=$(ask "Controller address" "")
		[[ -n $address ]] || die "Without the controller's address the companion cannot work yet."
		env_set OBBW_CONTROLLER_URL "http://${address#http://}"
	fi
	start
done
controller=$(sed -n 's/^ok controller //p' <<<"$RESULT")
say "Found the controller: $controller"
others=$(printf '%s\n' "$RESULT" | sed -n 's/^seen controller \(.*\): another controller.*/\1/p')
if [[ -n $others ]] && ! ((YES)); then
	say "Other controllers on your network: $(paste -sd, - <<<"$others")"
	if ! confirm "Keep using the one found above?"; then
		env_set OBBW_CONTROLLER_NAME "$(ask "Which one should the companion use" "$(head -n 1 <<<"$others")")"
		start
		wait_for_controller || die "The companion did not find that controller. Run: docker compose logs"
	fi
fi

bold "Checking the Web UI through the companion"
if web=$(check --controller); then
	say "The Web UI answers through the secure address."
else
	warn "$(tail -n 1 <<<"$web")"
	warn "The companion works, but the controller did not answer. Is the espresso machine on?"
fi

setup_url=$(docker compose exec -T companion python3 -c 'import json; print(json.load(open("/run/gateway/status.json"))["setup_url"])')
bold "Done"
say "On each phone, tablet or computer, open $setup_url (plain http) and follow the"
say "steps for that device. On a phone, scan this code:"
docker compose exec -T companion qrencode -t ANSIUTF8 -m 2 "$setup_url" || true
if [[ $(env_get COMPOSE_FILE) != *host* ]]; then
	say "This server itself cannot open the companion's address; every other device can."
fi
say "Run ./setup again any time to check it or to change its settings."
