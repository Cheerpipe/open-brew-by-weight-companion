# ./setup writes .env from this file. To do it by hand, copy it to .env and
# adjust. Lines left empty use the default.

# --- LAN placement (./setup fills these in) --------------------------------
# Free address for the gateway, outside your router's DHCP range.
GATEWAY_IP=192.168.1.240
# Server network interface connected to the LAN (see `ip -br addr`).
LAN_INTERFACE=eth0
LAN_SUBNET=192.168.1.0/24
# Your router's address.
LAN_ROUTER=192.168.1.1
# macvlan for wired servers; ipvlan when the server is on Wi-Fi.
LAN_DRIVER=macvlan
# How the gateway joins the network (./setup chooses):
# - its own address (default): leave COMPOSE_FILE commented out;
# - the server's address, when ports 80 and 443 are free there:
#   COMPOSE_FILE=compose.yaml:compose.host.yaml
# - a macvlan/ipvlan network that already exists (`docker network ls`), since
#   Docker allows only one per range:
#   COMPOSE_FILE=compose.yaml:compose.existing-network.yaml
#   LAN_NETWORK=my-macvlan
# COMPOSE_FILE=
# LAN_NETWORK=

# --- Secure address ----------------------------------------------------------
# Name published over mDNS; devices open https://<name>.local.
# Changing it creates a new certificate authority: set up every device again.
GATEWAY_HOSTNAME=openbrewbyweight-secure
# Turn off when your own DNS already points the name at GATEWAY_IP.
MDNS_PUBLISH=true
HTTP_PORT=80
HTTPS_PORT=443

# --- Controller --------------------------------------------------------------
# Empty: find the controller automatically.
# Set to http://<ip> or http://<name>.local to use that controller only.
OBBW_CONTROLLER_URL=
# With several controllers, the device name to use (as shown in the Web UI).
OBBW_CONTROLLER_NAME=

# --- Storage -----------------------------------------------------------------
# Folder for the certificate authority. Keep it: deleting it means setting up
# every device again.
GATEWAY_DATA=./data
